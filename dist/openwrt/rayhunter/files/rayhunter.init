#!/bin/sh /etc/rc.common
# Rayhunter on the GL.iNet Mudi V2. If recordings go to the SD card, wait until it is
# mounted, so that they don't end up on the router's flash.
START=99
STOP=10
USE_PROCD=1

CONFIG=/etc/rayhunter/config.toml

start_service() {
	local store mount
	store=$(sed -n 's/^qmdl_store_path *= *"\(.*\)"/\1/p' "$CONFIG")
	mount=$(echo "$store" | sed -n 's#^\(/mnt/[^/]*\).*#\1#p')
	procd_open_instance
	# the paths are passed as arguments, never pasted into the script text
	procd_set_param command /bin/sh -c '
		if [ -n "$1" ] && ! grep -qF " $1 " /proc/mounts; then
			logger -t rayhunter "waiting for $1"
			while ! grep -qF " $1 " /proc/mounts; do sleep 5; done
		fi
		mkdir -p -- "$2" && exec /usr/bin/rayhunter-daemon "$3"' rayhunter "$mount" "$store" "$CONFIG"
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
